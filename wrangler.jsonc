{
  // AfterIDo runs as a single Cloudflare Worker that serves the built SPA from
  // ./dist and answers /api/* itself. One free-tier service covers hosting,
  // the API, and the database — see LAUNCH_GUIDE.md for the setup steps.
  "name": "afterido",
  "main": "worker/index.ts",
  "compatibility_date": "2025-11-01",

  // Not a secret — it's in the address bar of every Cloudflare dashboard page.
  "account_id": "ff4b01fbc362a9e794842a52c0ce2996",

  // Binds the Worker to the real domain and creates the DNS record for it.
  // Until the domain is active in this Cloudflare account, comment this out
  // and the Worker still serves at afterido.christadore.workers.dev.
  "routes": [{ "pattern": "after-i-do.com", "custom_domain": true }],

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Deep links like /app/checklist are client-side routes, so anything that
    // isn't a real file must return index.html rather than a 404.
    "not_found_handling": "single-page-application",
    // The Worker sees HTML and API requests, because it rewrites each page's
    // title and link-preview tags for the route being served (worker/seo.ts)
    // and generates robots.txt and sitemap.xml. The hashed assets and icons
    // are excluded: they are the bulk of the request volume, and served
    // straight from the edge they cost nothing against the free tier.
    "run_worker_first": [
      "/*",
      "!/assets/*",
      "!/*.png",
      "!/*.svg",
      "!/*.ico",
      "!/*.webmanifest"
    ]
  },

  "d1": [
    {
      "binding": "DB",
      "database_name": "after-i-do",
      "database_id": "f5ec300b-7be0-4184-bd56-99f6fa29aa73",
      "migrations_dir": "migrations"
   }
   ],

  // Hourly sweep that sends any reminder emails that have come due.
  "triggers": { "crons": ["0 * * * *"] },

  "vars": {
    // Public, non-secret configuration. Secrets are set in the dashboard under
    // Settings → Variables and Secrets, and never appear in this file:
    //   SESSION_SECRET, STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, RESEND_API_KEY
    "PUBLIC_ORIGIN": "https://after-i-do.com",
    "EMAIL_FROM": "AfterIDo <hello@after-i-do.com>",

    // From Stripe, once the product exists. Payments stay switched off, and
    // the UI says so, until this is filled in.
    "STRIPE_PRICE_ID": "prod_V8Gkb96HlvX2Vk",

    // Shown publicly on the Contact page and in the legal pages, so choose it
    // deliberately — this is the address real customers will write to about
    // refunds. Until it is set, the Contact page says no address is configured
    // rather than inventing one.
    "SUPPORT_EMAIL": "",

    "PRICE_LABEL": "$19.99"
  },

  "observability": { "enabled": true }
}
