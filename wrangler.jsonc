{
  "$schema": "./node_modules/wrangler/config-schema.json",

  // AfterIDo runs as a single Cloudflare Worker that serves the built SPA from
  // ./dist and handles /api/* itself. Cloudflare Workers + D1 provide hosting,
  // the API, and the database.

  "name": "afterido",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-28",

  // Cloudflare account ID. This is not a secret.
  "account_id": "ff4b01fbc362a9e794842a52c0ce2996",

  // Serve the production site on the real domain.
  "routes": [
    {
      "pattern": "after-i-do.com",
      "custom_domain": true
    }
  ],

  // Serve the Vite/React production build from Cloudflare Workers Assets.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",

    // React Router deep links such as /app/checklist must resolve to index.html.
    "not_found_handling": "single-page-application",

    // Run the Worker first for HTML/API/SEO requests. Static hashed assets,
    // images, icons, and manifests can be served directly from the edge.
    "run_worker_first": [
      "/*",
      "!/assets/*",
      "!/*.js",
      "!/*.css",
      "!/*.png",
      "!/*.jpg",
      "!/*.jpeg",
      "!/*.gif",
      "!/*.webp",
      "!/*.svg",
      "!/*.ico",
      "!/*.woff",
      "!/*.woff2",
      "!/*.ttf",
      "!/*.webmanifest"
    ]
  },

  // IMPORTANT: the Wrangler property is d1_databases, not d1.
  // The binding name DB is what worker/env.ts and worker/index.ts use as env.DB.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "after-i-do",
      "database_id": "f5ec300b-7be0-4184-bd56-99f6fa29aa73",
      "migrations_dir": "migrations"
    }
  ],

  // Hourly sweep that sends reminder emails that have come due.
  "triggers": {
    "crons": ["0 * * * *"]
  },

  // Public configuration only. Secrets belong in Cloudflare Workers
  // Settings -> Variables and Secrets. The four that matter are
  // SESSION_SECRET, STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET and
  // RESEND_API_KEY; until all four exist, /api/config reports the matching
  // capability as false and the app says so rather than pretending.
  "vars": {
    "PUBLIC_ORIGIN": "https://after-i-do.com",

    // Sending address. Needs the domain verified in Resend, and RESEND_API_KEY
    // set as a secret, before any mail actually leaves.
    "EMAIL_FROM": "AfterIDo <hello@after-i-do.com>",

    // The one-time Stripe PRICE id (price_...), not the Product id (prod_...).
    // Test mode and live mode have entirely separate prices: switching Stripe
    // to live means replacing this as well as the two Stripe secrets.
    "STRIPE_PRICE_ID": "price_1U80DT8mCr3UaAaiA4wlbPjJ",

    // Shown publicly on the Contact page and in the Terms and Privacy Policy,
    // and where refund requests arrive. This must be an address that RECEIVES
    // mail — verifying a sending domain in Resend does not create an inbox.
    "SUPPORT_EMAIL": "hello@after-i-do.com",

    "PRICE_LABEL": "$19.99"
  },

  "observability": {
    "enabled": true
  }
}
